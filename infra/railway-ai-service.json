{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ai-service/Dockerfile"
  },
  "deploy": {
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port 8000",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  },
  "envVars": {
    "OPENAI_API_KEY": "${{OPENAI_API_KEY}}"
  }
}
